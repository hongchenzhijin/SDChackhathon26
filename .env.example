# Copy to .env locally (or add as Replit Secrets). Every variable is optional:
# with none set, the app runs fully on its transparent fallbacks.

# Server
PORT=3000
# AUTO_REFRESH_HOURS=24          # rebuild the trend snapshot on a schedule
# AI_RATE_LIMIT=30               # AI requests per IP per 10 minutes (protects RunPod credit)

# RunPod Serverless (https://www.runpod.io/console/serverless)
RUNPOD_API_KEY=
RUNPOD_SKILL_ENDPOINT_ID=        # custom worker: skill extraction from CV text
RUNPOD_FORECAST_ENDPOINT_ID=     # custom worker: skill-trend forecasting
RUNPOD_LLM_ENDPOINT_ID=          # vLLM worker (OpenAI-compatible) for plain-language explanations
RUNPOD_LLM_MODEL=                # model name served by that vLLM worker, e.g. meta-llama/Llama-3.1-8B-Instruct
# RUNPOD_TIMEOUT_MS=90000        # cold starts can take a while
# RUNPOD_BASE_URL=https://api.runpod.ai/v2
